flowchart LR
    subgraph C1["Camera/RPi × 6"]
        CAM["Camera"] --> ENC["H.264 Encoder"] --> MTX["MediaMTX"]
    end

    subgraph FAST["Fast video plane"]
        WEBRTC["WebRTC / LL-HLS<br/>preferred"]
        MJPEG["Latest-frame MJPEG<br/>fallback"]
    end

    subgraph AI["Central AI server"]
        CAP["LatestFrameCapture<br/>one slot per camera"]
        WATCH["Cheap Watcher<br/>CPU 10~20 Hz"]
        ROI["Bed ROI Manager"]
        CTRL["Camera Controller<br/>state + TTL"]
        MAIL["Latest Request Mailbox<br/>no frame backlog"]
        SCHED["Deadline/Priority Scheduler"]

        subgraph SHARED["Shared model services"]
            SEG["Bed Seg GPU"]
            POSE["Pose GPU"]
            KERAS["6-class CPU"]
            TCN["TCN CPU"]
        end

        FUSION["Fusion/Event Manager"]
        API["Snapshot API<br/>Event stream"]

        CAP --> WATCH --> CTRL
        CAP --> ROI --> CTRL
        CTRL --> MAIL --> SCHED
        SCHED --> SEG
        SCHED --> POSE
        POSE --> KERAS
        POSE --> TCN
        ROI --> FUSION
        KERAS --> FUSION
        TCN --> FUSION
        WATCH --> FUSION
        FUSION --> CTRL
        FUSION --> API
        CAP --> MJPEG
    end

    subgraph BROWSER["Browser"]
        VIDEO["Video plane"]
        DATA["Data plane"]
        UI["Viewer overlay"]
        VIDEO --> UI
        DATA --> UI
    end

    MTX -->|"RTSP inference subscription"| CAP
    MTX --> WEBRTC --> VIDEO
    MJPEG -.-> VIDEO
    API --> DATA

