    C1 --> M1[(pose/bed_161 mailbox)]
    C2 --> M2[(pose/bed_162 mailbox)]
    CN --> MN[(model/camera mailbox)]

    M1 --> Q{priority selector}
    M2 --> Q
    MN --> Q

    P0[P0 VERIFY] --> Q
    P1[P1 BURST] --> Q
    P2[P2 OCCUPIED] --> Q
    P3[P3 EMPTY probe] --> Q
    P4[P4 Bed segmentation] --> Q

    Q -->|deadline expired| DROP[stale drop]
    Q -->|newer same mailbox| REPLACE[superseded drop]
    Q -->|urgent 4회 후| FAIR[oldest normal 1회]
    Q --> GPU[단일 중앙 GPU worker]
    GPU --> POSE[YOLO Pose weight]
    GPU --> SEG[Bed Seg weight]
    POSE --> RESULT[요청 카메라 결과]
    SEG --> RESULT
    RESULT --> API[/status completed Hz queue ms drops]
    RESULT --> FUSION[6-class + TCN shadow + bed relation]

    VIDEO[독립 LatestFrameCapture] --> VIEWER[/video viewer 약 20FPS]
    VIDEO --> C1
    VIDEO --> C2
    VIDEO --> CN
