flowchart LR
    subgraph EDGE["RPi 카메라 장치 × 6"]
        CAM["카메라 촬영"]
        ENC["H.264 인코딩"]
        RTSP["RTSP 송출<br/>:8554/stream"]
        CAM --> ENC --> RTSP
    end

    subgraph CENTRAL["중앙 서버 192.168.0.108"]
        LAUNCH["run_all_cameras.sh"]
        SERVER["server_all_cameras.py<br/>단일 Python 프로세스"]
        THREADS["카메라 분석 스레드 × 6"]

        subgraph SHARED["프로세스 전체 공유 모델"]
            SEG["YOLO Bed Seg<br/>GPU 0"]
            POSE["YOLO Pose<br/>GPU 0"]
            KERAS["Keras 6-class<br/>CPU"]
            TCN["Causal TCN<br/>CPU · Shadow"]
        end

        subgraph PER_CAMERA["카메라마다 분리"]
            STATE["상태머신"]
            BUFFER["10 Hz × 3초 버퍼"]
            RESULT["CameraState"]
        end

        API["FastAPI :8000"]

        LAUNCH --> SERVER
        SERVER --> THREADS
        SERVER --> SHARED
        THREADS --> STATE
        STATE --> SEG
        STATE --> POSE
        POSE --> KERAS
        POSE --> BUFFER
        KERAS --> BUFFER
        BUFFER --> TCN
        SEG --> RESULT
        KERAS --> RESULT
        TCN --> RESULT
        RESULT --> API
    end

    subgraph CLIENT["모니터링 PC / 앱"]
        VIEWER["/viewer"]
        VIDEO["/video/bed_ID<br/>MJPEG"]
        STATUS["/status<br/>JSON"]
    end

    RTSP ==>|"중앙 서버가 pull"| THREADS
    API --> VIEWER
    API --> VIDEO
    API --> STATUS

    NOTE["RPi에는 모델 가중치 없음<br/>브라우저도 추론하지 않음"]
    NOTE -.-> EDGE
    NOTE -.-> CLIENT
