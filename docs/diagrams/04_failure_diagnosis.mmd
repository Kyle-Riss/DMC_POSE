flowchart TD
    START["화면이 멈추거나 결과가 이상함"] --> TS{"/status timestamp가 증가?"}

    TS -->|"예"| VIDEO{"/video에서 JPEG가<br/>연속 수신되는가?"}
    TS -->|"아니오"| RTSP{"RPi RTSP ffprobe 성공?"}

    VIDEO -->|"예"| CACHE["브라우저 문제<br/>구버전 탭 종료<br/>Ctrl + Shift + R"]
    VIDEO -->|"아니오"| PUBLISH["MJPEG frame publish 경로 점검"]

    RTSP -->|"아니오"| EDGE["RPi 점검<br/>카메라 · MediaMTX<br/>유선망 · 전원"]
    RTSP -->|"예"| DECODE["중앙 OpenCV/FFmpeg<br/>decode thread 점검"]

    DECODE --> OTHERS{"다른 5대는 정상?"}
    OTHERS -->|"예"| ONE["해당 카메라 단독 장애"]
    OTHERS -->|"아니오"| SHARED["공유 서버/모델/GPU 장애"]

    START --> LOG{"로그 형태"}
    LOG -->|"GET /video ... 200"| OKVIDEO["새 viewer 연결 정상"]
    LOG -->|"GET /image ... ?t= 반복"| OLD["구버전 viewer 탭"]
    LOG -->|"간헐적 h264 decode error"| WARN["입력 프레임 일부 손상<br/>timestamp가 움직이면 경고"]
    LOG -->|"timestamp 정지/disconnected"| FAIL["실제 카메라 장애로 취급"]
